  "module: websocket handler template": {
    "prefix": "mod-websocket-handler",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
      "%%% Websockets Handler made from template",
      "%%% @author ${2:author}",
      "%%% @date ${3:YYYY/MM/DD HH-MM-SS}",
      "%%% @end",
      "%%%-----------------------------------------------------------------------------",
      "",
      "-module(${1:module_name}).",
      "-author(\"${2:author}\").",
      "",
      "%%%=============================================================================",
      "%%% Export and Defs",
      "%%%=============================================================================",
      "",
      "%% Websocket Callbacks",
      "-export([",
      "\tinit/2,",
      "\twebsocket_init/1,",
      "\twebsocket_handle/2,",
      "\twebsocket_info/2,",
      "\tterminate/3",
      "]).",
      "",
      "-define(SERVER, ?MODULE).",
      "",
      "%% Loop state",
      "-record(loop_state, {",
      "\tping_interval :: integer()",
      "}).",
      "-type loop_state() :: #loop_state{}.",
      "",
      "%%%=============================================================================",
      "%%% Websocket Handler Callbacks",
      "%%%=============================================================================",
      "",
      "init(Req, [{ping_interval, Interval}]) ->",
      "\t{cowboy_websocket, Req, #loop_state{",
      "\t\tping_interval = Interval",
      "\t}}.",
      "",
      "websocket_init(LoopState = #loop_state{ping_interval = Interval}) ->",
      "\terlang:start_timer(Interval, self(), ping),",
      "\t{reply, {binary, <<\"ping\">>}, LoopState}.",
      "",
      "websocket_handle({_, <<\"pong\">>}, LoopState = #loop_state{ping_interval = Interval}) ->",
      "\terlang:start_timer(Interval, self(), ping),",
      "\t{ok, LoopState};",
      "websocket_handle(_Msg, LoopState) ->",
      "\t{ok, LoopState}.",
      "",
      "websocket_info({timeout, _Ref, ping}, LoopState) ->",
      "\t{reply, {text, <<\"ping\">>}, LoopState};",
      "websocket_info(_Info, State) ->",
      "\t{ok, State}.",
      "",
      "terminate(_Reason, _Req, _LoopState) ->",
      "\tok.",
      "",
      "%%%=============================================================================",
      "%%% Internal functions",
      "%%%=============================================================================",
      "",
      "%%%=============================================================================",
      "%%% Eunit Tests",
      "%%%=============================================================================",
      "",
      "-ifdef(TEST).",
      "",
      "-include_lib(\"eunit/include/eunit.hrl\").",
      "",
      "example_test() ->",
      "    ?assertEqual(true, true).",
      "",
      "-endif.",
      "$0"
    ],
    "description": "cowboy websocket handler module template"
  },
  "module: cowboy rest handler template": {
    "prefix": "mod-rest-handler",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
