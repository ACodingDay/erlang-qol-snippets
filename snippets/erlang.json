  "module: gen_server template": {
    "prefix": "mod-genserver",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
      "%%% Gen Server built from template.",
      "%%% @author ${2:author}",
      "%%% @date ${3:YYYY/MM/DD HH-MM-SS}",
      "%%% @end",
      "%%%-----------------------------------------------------------------------------",
      "",
      "-module(${1:module_name}).",
      "-author(\"${2:author}\").",
      "-behaviour(gen_server).",
      "",
      "%%%=============================================================================",
      "%%% Export and Defs",
      "%%%=============================================================================",
      "",
      "%% External API",
      "-export([start_link/0]).",
      "",
      "%% Callbacks",
      "-export([",
      "\tinit/1,",
      "\thandle_call/3,",
      "\thandle_cast/2,",
      "\thandle_info/2,",
      "\tterminate/2,",
      "\tcode_change/3",
      "]).",
      "",
      "-define(SERVER, ?MODULE).",
      "",
      "%% Loop state",
      "-record(loop_state, {",
      "\t${4:fields}",
      "}).",
      "-type loop_state() :: #loop_state{}.",
      "",
      "%%%=============================================================================",
      "%%% API",
      "%%%=============================================================================",
      "",
      "-spec start_link() -> {ok, pid()} | {error, {already_started, pid()}} | {error, Reason::any()}.",
      "start_link() ->",
      "\tgen_server:start_link({local, ?SERVER}, ?MODULE, [], []).",
      "",
      "%%%=============================================================================",
      "%%% Gen Server Callbacks",
      "%%%=============================================================================",
      "",
      "init([]) ->",
      "\tLoopState = #loop_state{},",
      "\t{ok, LoopState}.",
      "",
      "handle_call(_Request, _From, LoopState) ->",
      "\tReply = ok,",
      "\t{reply, Reply, LoopState}.",
      "",
      "handle_cast(_Msg, LoopState) ->",
      "\t{noreply, LoopState}.",
      "",
      "handle_info(_Info, LoopState) ->",
      "\t{noreply, LoopState}.",
      "",
      "terminate(_Reason, _LoopState) ->",
      "\tok.",
      "",
      "code_change(_OldVsn, LoopState, _Extra) ->",
      "\t{ok, LoopState}.",
      "",
      "%%%=============================================================================",
      "%%% Internal functions",
      "%%%=============================================================================",
      "",
      "%%%=============================================================================",
      "%%% Eunit Tests",
      "%%%=============================================================================",
      "",
      "-ifdef(TEST).",
      "",
      "-include_lib(\"eunit/include/eunit.hrl\").",
      "",
      "example_test() ->",
      "    ?assertEqual(true, true).",
      "",
      "-endif.",
      "$0"
    ],
    "description": "gen_server module template"
  },
  "module: gen_statem template": {
    "prefix": "mod-genstatem",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
      "%%% Gen State Machine built from template.",
      "%%% @author ${2:author}",
      "%%% @date ${3:YYYY/MM/DD HH-MM-SS}",
      "%%% @end",
      "%%%-----------------------------------------------------------------------------",
      "",
      "-module(${1:module_name}).",
      "-author(\"${2:author}\").",
      "-behaviour(gen_statem).",
      "",
      "%%%=============================================================================",
      "%%% Export and Defs",
      "%%%=============================================================================",
      "",
      "-define(SERVER, ?MODULE).",
      "",
      "%% External API",
      "-export([",
      "\tstart_link/0,",
      "\tstop/0,",
      "\texample_action/0",
      "]).",
      "",
      "%% Gen State Machine Callbacks",
      "-export([",
      "\tinit/1,",
      "\tcode_change/4,",
      "\tcallback_mode/0,",
      "\tterminate/3",
      "]).",
      "",
      "%% State transitions",
      "-export([",
      "\texample_state/3,",
      "\tnext_example_state/3,",
      "\thandle_event/3",
      "]).",
      "",
      "%%%=============================================================================",
      "%%% API",
      "%%%=============================================================================",
      "",
      "-spec start_link() -> {ok, pid()} | {error, {already_started, pid()}} | {error, Reason::any()}.",
      "start_link() ->",
      "\tgen_statem:start_link({local, ?SERVER}, ?MODULE, [], []).",
      "",
      "-spec stop() -> ok.",
      "stop() ->",
      "\tgen_statem:stop(?SERVER).",
      "",
      "-spec example_action() -> term().",
      "example_action() ->",
      "\tgen_statem:call(?SERVER, example_action).",
      "",
      "%%%=============================================================================",
      "%%% Gen State Machine Callbacks",
      "%%%=============================================================================",
      "",
      "init([]) ->",
      "\tState = example_state,",
      "\tData = data,",
      "\t{ok, State, Data}.",
      "",
      "terminate(_Reason, _State, _Data) ->",
      "\tvoid.",
      "",
      "code_change(_Vsn, State, Data, _Extra) ->",
      "\t{ok, State, Data}.",
      "",
      "callback_mode() ->",
      "\tstate_functions.",
      "",
      "%%%=============================================================================",
      "%%% State transitions",
      "%%%=============================================================================",
      "",
      "example_state({call, From}, example_action, Data) ->",
      "\t{next_state, next_example_state, Data, [{reply, From, next_example_state}]};",
      "example_state(EventType, EventContent, Data) ->",
      "\thandle_event(EventType, EventContent, Data).",
      "",
      "next_example_state({call, From}, example_action, Data) ->",
      "\t{next_state, example_state, Data, [{reply, From, example_state}]};",
      "next_example_state(EventType, EventContent, Data) ->",
      "\thandle_event(EventType, EventContent, Data).",
      "",
      "%%------------------------------------------------------------------------------",
      "%% @doc",
      "%% Handle events common to all states.",
      "%% @end",
      "%%------------------------------------------------------------------------------",
      "",
      "handle_event({call, From}, get_count, Data) ->",
      "\t%% Reply with the current count",
      "\t{keep_state, Data, [{reply, From, Data}]};",
      "handle_event(_, _, Data) ->",
      "\t%% Ignore all other events",
      "\t{keep_state, Data}.",
      "",
      "%%%=============================================================================",
      "%%% Internal functions",
      "%%%=============================================================================",
      "",
      "%%%=============================================================================",
      "%%% Eunit Tests",
      "%%%=============================================================================",
      "",
      "-ifdef(TEST).",
      "",
      "-include_lib(\"eunit/include/eunit.hrl\").",
      "",
      "example_test() ->",
      "    ?assertEqual(true, true).",
      "",
      "-endif.",
      "$0"
    ],
    "description": "gen_statem module template"
  },
