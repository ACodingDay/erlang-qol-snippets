{
  "module: header template": {
    "prefix": "mod-header",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
      "%%% Header built from template",
      "%%% @author ${2:author}",
      "%%% @end",
      "%%%-----------------------------------------------------------------------------",
      "",
      "-ifndef(${1:FILE_HRL}).",
      "-define(${1:FILE_HRL}, true).",
      "",
      "%%%=============================================================================",
      "%%% Global Definitions",
      "%%%=============================================================================",
      "",
      "%% example record",
      "-record(example_record, {",
      "\t${3:fields}",
      "}).",
      "-type example_record() :: example_record.",
      "",
      "-endif.",
      "$0"
    ],
    "description": "header (hrl) module template with include guard"
  }
}
