{
  "supervisor child specs": {
    "prefix": "sups",
    "body": [
      "#{",
      "\tid => ${1:Mod},",
      "\tstart => {${1:Mod}, start_link, []},",
      "\trestart => permanent,     %% default: permanent",
      "\tshutdown => infinity,     %% default: infinity for a supervisor",
      "\ttype => supervisor,       %% default is worker; supervisor is required here",
      "\tmodules => [${1:Mod}]     %% default: [M] from start",
      "}",
      "$0"
    ],
    "description": "supervisor child specs"
  }
}
