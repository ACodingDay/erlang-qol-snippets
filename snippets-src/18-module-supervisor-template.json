{
  "module: supervisor template": {
    "prefix": "mod-supervisor",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
      "%%% Supervisor built from template.",
      "%%% @author ${2:author}",
      "%%% @date ${3:YYYY/MM/DD HH-MM-SS}",
      "%%% @end",
      "%%%-----------------------------------------------------------------------------",
      "",
      "-module(${1:module_name}).",
      "-author(\"${2:author}\").",
      "-behaviour(supervisor).",
      "",
      "%%%=============================================================================",
      "%%% Export and Defs",
      "%%%=============================================================================",
      "",
      "%% External API",
      "-export([",
      "\tstart_link/0",
      "]).",
      "",
      "%% Callbacks",
      "-export([init/1]).",
      "",
      "-define(SERVER, ?MODULE).",
      "",
      "%%%=============================================================================",
      "%%% API",
      "%%%=============================================================================",
      "",
      "-spec start_link() -> supervisor:startlink_ret().",
      "start_link() ->",
      "\tsupervisor:start_link({local, ?SERVER}, ?MODULE, []).",
      "",
      "%%%=============================================================================",
      "%%% Callbacks",
      "%%%=============================================================================",
      "",
      "init([]) ->",
      "\tSupFlags = #{strategy => one_for_one,   %% default: one_for_one (restart only the failed child)",
      "\t             intensity => 1,            %% default: 1 (allowed restarts within Period)",
      "\t             period => 5},              %% default: 5 seconds",
      "\tChildSpecs = ${4:[]},",
      "\t{ok, {SupFlags, ChildSpecs}}.",
      "",
      "%%%=============================================================================",
      "%%% Internal functions",
      "%%%=============================================================================",
      "",
      "%%%=============================================================================",
      "%%% Eunit Tests",
      "%%%=============================================================================",
      "",
      "-ifdef(TEST).",
      "",
      "-include_lib(\"eunit/include/eunit.hrl\").",
      "",
      "example_test() ->",
      "    ?assertEqual(true, true).",
      "",
      "-endif.",
      "$0"
    ],
    "description": "supervisor module template"
  }
}
