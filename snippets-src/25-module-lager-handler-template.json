{
  "module: lager handler template": {
    "prefix": "mod-lager-handler",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
      "%%% Lager Handler built from template",
      "%%% @author ${2:author}",
      "%%% @date ${3:YYYY/MM/DD HH-MM-SS}",
      "%%% @end",
      "%%%-----------------------------------------------------------------------------",
      "",
      "-module(${1:module_name}).",
      "-author(\"${2:author}\").",
      "-behaviour(gen_event).",
      "",
      "%% Install via app env: {handlers, [{?MODULE, [{level, info}]}]}.",
      "",
      "%%%=============================================================================",
      "%%% Export and Defs",
      "%%%=============================================================================",
      "",
      "%% gen_event Callbacks",
      "-export([",
      "\tinit/1,",
      "\thandle_call/2,",
      "\thandle_event/2,",
      "\thandle_info/2,",
      "\tterminate/2,",
      "\tcode_change/3",
      "]).",
      "",
      "%% Loop state",
      "-record(state, {",
      "\tlevel :: {'mask', integer()}",
      "}).",
      "-type state() :: #state{}.",
      "",
      "%%%=============================================================================",
      "%%% Lager Handler Callbacks",
      "%%%=============================================================================",
      "",
      "init(Options) when is_list(Options) ->",
      "\tLevel = proplists:get_value(level, Options, info),",
      "\t{ok, #state{level = lager_util:config_to_mask(Level)}}.",
      "",
      "handle_call(get_loglevel, #state{level = Level} = State) ->",
      "\t{ok, Level, State};",
      "handle_call({set_loglevel, Level}, State) ->",
      "\ttry lager_util:config_to_mask(Level) of",
      "\t\tMask ->",
      "\t\t\t{ok, ok, State#state{level = Mask}}",
      "\tcatch",
      "\t\t_:_ ->",
      "\t\t\t{ok, {error, bad_log_level}, State}",
      "\tend;",
      "handle_call(_Request, State) ->",
      "\t{ok, ok, State}.",
      "",
      "handle_event({log, Message}, #state{level = Level} = State) ->",
      "\tcase lager_util:is_loggable(Message, Level, ?MODULE) of",
      "\t\ttrue ->",
      "\t\t\t%% TODO: process Message (#lager_msg{})",
      "\t\t\t{ok, State};",
      "\t\tfalse ->",
      "\t\t\t{ok, State}",
      "\tend;",
      "handle_event(_Event, State) ->",
      "\t{ok, State}.",
      "",
      "handle_info(_Info, State) ->",
      "\t{ok, State}.",
      "",
      "terminate(_Reason, _State) ->",
      "\tok.",
      "",
      "code_change(_OldVsn, State, _Extra) ->",
      "\t{ok, State}.",
      "",
      "%%%=============================================================================",
      "%%% Internal functions",
      "%%%=============================================================================",
      "",
      "%%%=============================================================================",
      "%%% Eunit Tests",
      "%%%=============================================================================",
      "",
      "-ifdef(TEST).",
      "",
      "-include_lib(\"eunit/include/eunit.hrl\").",
      "",
      "example_test() ->",
      "    ?assertEqual(true, true).",
      "",
      "-endif.",
      "$0"
    ],
    "description": "lager handler (gen_event) module template"
  }
}
