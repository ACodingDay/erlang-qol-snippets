{
  "module: lager handler template": {
    "prefix": "mod-lager-handler",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
      "%%% Lager Handler built from template",
      "%%% @author ${2:author}",
      "%%% @end",
      "%%%-----------------------------------------------------------------------------",
      "",
      "-module(${1:module_name}).",
      "-author(\"${2:author}\").",
      "-behaviour(gen_event).",
      "",
      "%%%=============================================================================",
      "%%% Export and Defs",
      "%%%=============================================================================",
      "",
      "-define(SERVER, ?MODULE).",
      "",
      "%% Websocket Callbacks",
      "-export([",
      "\tinit/1,",
      "\thandle_call/2,",
      "\thandle_event/2,",
      "\thandle_info/2,",
      "\tterminate/2,",
      "\tcode_change/3",
      "]).",
      "",
      "%% Loop state",
      "-record(state, {",
      "\tlevel :: integer()",
      "}).",
      "-type state() :: state.",
      "",
      "%%%=============================================================================",
      "%%% Lager Handler Callbacks",
      "%%%=============================================================================",
      "",
      "init([Level, _RetryTimes, _RetryInterval, _Token]) ->",
      "\tState = #state{",
      "\t\tlevel = lager_util:level_to_num(Level)",
      "\t},",
      "\t{ok, State}.",
      "",
      "handle_call(get_loglevel, #state{level = Level} = State) ->",
      "\t{ok, Level, State};",
      "handle_call({set_loglevel, Level}, State) ->",
      "\t{ok, ok, State#state{level = lager_util:level_to_num(Level)}};",
      "handle_call(_Request, State) ->",
      "\t{ok, ok, State}.",
      "",
      "handle_event({log, _Message}, _State) ->",
      "\tok;",
      "handle_event(_Event, State) ->",
      "\t{ok, State}.",
      "",
      "handle_info(_Info, State) ->",
      "\t{ok, State}.",
      "",
      "terminate(_Reason, _State) ->",
      "\tok.",
      "",
      "code_change(_OldVsn, State, _Extra) ->",
      "\t{ok, State}.",
      "",
      "%%%=============================================================================",
      "%%% Internal functions",
      "%%%=============================================================================",
      "",
      "%%%=============================================================================",
      "%%% Eunit Tests",
      "%%%=============================================================================",
      "",
      "-ifdef(TEST).",
      "",
      "-include_lib(\"eunit/include/eunit.hrl\").",
      "",
      "example_test() ->",
      "    ?assertEqual(true, true).",
      "",
      "-endif.",
      "$0"
    ],
    "description": "lager handler (gen_event) module template"
  }
}
