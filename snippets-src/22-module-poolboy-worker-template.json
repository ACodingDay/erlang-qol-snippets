{
  "module: poolboy worker template": {
    "prefix": "mod-poolboy-worker",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
      "%%% Poolboy Worker built from template.",
      "%%% @author ${2:author}",
      "%%% @end",
      "%%%-----------------------------------------------------------------------------",
      "",
      "-module(${1:module_name}).",
      "-author(\"${2:author}\").",
      "-behaviour(poolboy_worker).",
      "",
      "%%%=============================================================================",
      "%%% Export and Defs",
      "%%%=============================================================================",
      "",
      "%% External API",
      "-export([start_link/1]).",
      "",
      "%% Callbacks",
      "-export([",
      "\tinit/1,",
      "\thandle_call/3,",
      "\thandle_cast/2,",
      "\thandle_info/2,",
      "\tterminate/2,",
      "\tcode_change/3",
      "]).",
      "",
      "-define(SERVER, ?MODULE).",
      "",
      "%% Loop state",
      "-record(loop_state, {",
      "\t${3:fields}",
      "}).",
      "-type loop_state() :: loop_state.",
      "",
      "%%%=============================================================================",
      "%%% API",
      "%%%=============================================================================",
      "",
      "-spec start_link(map()) -> {ok, pid()} | {error, {already_started, pid()}} | {error, Reason::any()}.",
      "start_link(Args) ->",
      "\tgen_server:start_link(?MODULE, Args, []).",
      "",
      "%%%=============================================================================",
      "%%% Callbacks",
      "%%%=============================================================================",
      "",
      "init(_Args) ->",
      "\tprocess_flag(trap_exit, true),",
      "\t{ok, #loop_state{}}.",
      "",
      "handle_call(_Request, _From, LoopState) ->",
      "\tReply = ok,",
      "\t{reply, Reply, LoopState}.",
      "",
      "handle_cast(_Msg, LoopState) ->",
      "\t{noreply, LoopState}.",
      "",
      "handle_info(_Info, LoopState) ->",
      "\t{noreply, LoopState}.",
      "",
      "terminate(_Reason, _LoopState) ->",
      "\tok.",
      "",
      "code_change(_OldVsn, LoopState, _Extra) ->",
      "\t{ok, LoopState}.",
      "",
      "%%%=============================================================================",
      "%%% Internal functions",
      "%%%=============================================================================",
      "",
      "%%%=============================================================================",
      "%%% Eunit Tests",
      "%%%=============================================================================",
      "",
      "-ifdef(TEST).",
      "",
      "-include_lib(\"eunit/include/eunit.hrl\").",
      "",
      "example_test() ->",
      "    ?assertEqual(true, true).",
      "",
      "-endif.",
      "$0"
    ],
    "description": "poolboy worker module template"
  }
}
