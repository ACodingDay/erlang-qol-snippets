{
  "module: cowboy rest handler template": {
    "prefix": "mod-rest-handler",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
      "%%% Cowboy Rest Handler built from template.",
      "%%% @author ${2:author}",
      "%%% @date ${3:YYYY/MM/DD HH-MM-SS}",
      "%%% @end",
      "%%%-----------------------------------------------------------------------------",
      "",
      "-module(${1:module_name}).",
      "-author(\"${2:author}\").",
      "",
      "%%%=============================================================================",
      "%%% Export and Defs",
      "%%%=============================================================================",
      "",
      "%% Websocket Callbacks",
      "-export([",
      "\tinit/2,",
      "\tallowed_methods/2,",
      "\tcontent_types_provided/2,",
      "\tcontent_types_accepted/2",
      "]).",
      "",
      "%% Websocket Handlers",
      "-export([",
      "\tget_function/2,",
      "\tput_function/2",
      "]).",
      "",
      "-define(SERVER, ?MODULE).",
      "",
      "%% Loop state",
      "-record(loop_state, {",
			"\t${4:fields}",
      "}).",
      "-type loop_state() :: loop_state.",
      "",
      "%%%=============================================================================",
      "%%% Cowboy Rest Handler Callbacks",
      "%%%=============================================================================",
      "",
      "init(Req, Opts) ->",
      "\t{cowboy_rest, Req, Opts}.",
      "",
      "%%------------------------------------------------------------------------------",
      "%% @doc",
      "%% REST methods supported by handler.",
      "%% @end",
      "%%------------------------------------------------------------------------------",
      "",
      "allowed_methods(Req, State) ->",
      "\t{[<<\"GET\">>, <<\"POST\">>, <<\"OPTIONS\">>], Req, State}.",
      "",
      "%%------------------------------------------------------------------------------",
      "%% @doc",
      "%% Define handler functions for GET and HEAD calls, with parameters if needed.",
      "%% @end",
      "%%------------------------------------------------------------------------------",
      "",
      "content_types_provided(Req, State) ->",
      "\t{[",
      "\t\t{{<<\"text\">>, <<\"html\">>, []}, get_function},",
      "\t\t{{<<\"application\">>, <<\"json\">>, []}, get_function},",
      "\t\t{{<<\"text\">>, <<\"plain\">>, []}, get_function}",
      "\t], Req, State}.",
      "",
      "%%------------------------------------------------------------------------------",
      "%% @doc",
      "%% Define handler functions for PUT/POST type calls, with parameters if needed.",
      "%% @end",
      "%%------------------------------------------------------------------------------",
      "",
      "content_types_accepted(Req, State) ->",
      "\t{[",
      "\t\t{{<<\"text\">>, <<\"html\">>, []}, put_function},",
      "\t\t{{<<\"application\">>, <<\"json\">>, []}, put_function},",
      "\t\t{{<<\"text\">>, <<\"plain\">>, []}, put_function}",
      "\t], Req, State}.",
      "",
      "%%%=============================================================================",
      "%%% Handlers",
      "%%%=============================================================================",
      "",
      "get_function(Req, State) ->",
      "\t{<<\"\">>, Req, State}.",
      "",
      "put_function(Req, State) ->",
      "\tReq1 = cowboy_req:reply(200, #{}, <<\"Response\">>, Req),",
      "\t{stop, Req1, State}.",
      "",
      "%%%=============================================================================",
      "%%% Internal functions",
      "%%%=============================================================================",
      "",
      "%%%=============================================================================",
      "%%% Eunit Tests",
      "%%%=============================================================================",
      "",
      "-ifdef(TEST).",
      "",
      "-include_lib(\"eunit/include/eunit.hrl\").",
      "",
      "example_test() ->",
      "    ?assertEqual(true, true).",
      "",
      "-endif.",
      "$0"
    ],
    "description": "cowboy REST handler module template"
  }
}
