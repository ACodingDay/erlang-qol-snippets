{
  "worker child specs": {
    "prefix": "works",
    "body": [
      "#{",
      "\tid => ${1:Mod},",
      "\tstart => {${1:Mod}, start_link, []},",
      "\trestart => permanent,     %% default: permanent",
      "\tshutdown => 5000,         %% default: 5000 ms for a worker",
      "\ttype => worker,           %% default: worker",
      "\tmodules => [${1:Mod}]     %% default: [M] from start",
      "}",
      "$0"
    ],
    "description": "worker child specs"
  }
}
