{
  "module: empty template": {
    "prefix": "mod-empty",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
      "%%% Empty Module built from template.",
      "%%% @author ${2:author}",
      "%%% @date ${3:YYYY/MM/DD HH-MM-SS}",
      "%%% @end",
      "%%%-----------------------------------------------------------------------------",
      "",
      "-module(${1:module_name}).",
      "-author(\"${2:author}\").",
      "",
      "%%%=============================================================================",
      "%%% Export and Defs",
      "%%%=============================================================================",
      "",
      "%% External API",
      "-export([",
			"\t${4:exports}",
      "]).",
      "",
      "-define(SERVER, ?MODULE).",
      "",
      "%%%=============================================================================",
      "%%% API",
      "%%%=============================================================================",
      "",
      "%%%=============================================================================",
      "%%% Internal functions",
      "%%%=============================================================================",
      "",
      "%%%=============================================================================",
      "%%% Eunit Tests",
      "%%%=============================================================================",
      "",
      "-ifdef(TEST).",
      "",
      "-include_lib(\"eunit/include/eunit.hrl\").",
      "",
      "example_test() ->",
      "    ?assertEqual(true, true).",
      "",
      "-endif.",
      "$0"
    ],
    "description": "empty module template"
  }
}
