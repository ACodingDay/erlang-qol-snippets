{
  "module: CT template": {
    "prefix": "mod-ct",
    "body": [
      "%%%-----------------------------------------------------------------------------",
      "%%% @doc",
      "%%% Common Tests built from template.",
      "%%% @author ${2:author}",
      "%%% @end",
      "%%%-----------------------------------------------------------------------------",
      "",
      "-module(${1:module_name}).",
      "-author(\"${2:author}\").",
      "",
      "-include_lib(\"common_test/include/ct.hrl\").",
      "-include_lib(\"stdlib/include/assert.hrl\").",
      "",
      "%%%=============================================================================",
      "%%% Export and Defs",
      "%%%=============================================================================",
      "",
      "-define(SERVER, ?MODULE).",
      "",
      "-export([",
      "\tall/0,",
      "\tinit_per_suite/1,",
      "\tinit_per_testcase/2,",
      "\tend_per_testcase/2,",
      "\tend_per_suite/1",
      "]).",
      "",
      "-export([",
      "\texample_test/1",
      "]).",
      "",
      "%%%=============================================================================",
      "%%% CT Functions",
      "%%%=============================================================================",
      "",
      "all() ->",
      "\t[example_test].",
      "",
      "init_per_suite(Config) ->",
      "\tConfig.",
      "",
      "init_per_testcase(_TestName, Config) ->",
      "\tConfig.",
      "",
      "end_per_testcase(_TestName, Config) ->",
      "\tConfig.",
      "",
      "end_per_suite(Config) ->",
      "\tConfig.",
      "",
      "%%%=============================================================================",
      "%%% Tests",
      "%%%=============================================================================",
      "",
      "example_test(_Config) ->",
      "\t?assertEqual(true, true, <<\"Example Comment\">>).",
      "",
      "%%%=============================================================================",
      "%%% Internal functions",
      "%%%=============================================================================",
      "$0"
    ],
    "description": "Common Test (CT) suite template"
  }
}
